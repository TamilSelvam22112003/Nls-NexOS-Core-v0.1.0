{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NLS Router Enrollment Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "router_id",
    "csr_pem",
    "request_id",
    "nonce",
    "timestamp",
    "rsa_encryption_public_key",
    "rsa_proof_of_possession"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "router_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "csr_pem": {
      "type": "string",
      "minLength": 100,
      "maxLength": 50000
    },
    "request_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "nonce": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "rsa_encryption_public_key": { "type": "string", "minLength": 100, "maxLength": 20000 },
    "rsa_proof_of_possession": { "type": "string", "minLength": 80, "maxLength": 4096 },
    "claimed_ipv6": {
      "type": "string",
      "maxLength": 64
    },
    "claimed_mac": {
      "type": "string",
      "maxLength": 32
    }
  }
}
